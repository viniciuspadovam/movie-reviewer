# Copy to infra/.env on the VM (never commit the real file). Values in single quotes are taken literally,
# which matters for the BCrypt hash: its "$" characters would otherwise be interpolated by Docker Compose.

POSTGRES_DB=moviereview
POSTGRES_USER=moviereview
POSTGRES_PASSWORD='change-me-long-random'

# https://<your-domain> (no trailing slash)
FRONTEND_ORIGIN=https://example.com
# Leading dot so the front (<domain>) can read the XSRF cookie set by api.<domain>
COOKIE_DOMAIN=.example.com

ADMIN_USERNAME=admin
# Generate with: docker run --rm httpd:2.4-alpine htpasswd -nbBC 10 "" 'your-password' | tr -d ':\n' | sed 's/^\$2y/\$2a/'
ADMIN_PASSWORD_HASH='$2a$10$replace-with-your-bcrypt-hash'
# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET='replace-with-a-long-random-secret'

# TMDB "API Read Access Token" (v4 auth), from https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN='replace-with-tmdb-read-access-token'

# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > token
CLOUDFLARE_TUNNEL_TOKEN='replace-with-tunnel-token'

# Used by infra/backup.sh (rclone remote configured with Cloudflare R2 credentials)
BACKUP_REMOTE=r2:movie-review-backups
BACKUP_RETENTION_DAYS=30
