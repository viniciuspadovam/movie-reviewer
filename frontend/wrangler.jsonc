{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pos-creditos",
  "compatibility_date": "2026-10-01",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist/frontend/browser",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
  // API_ORIGIN (URL do Cloud Run) é passado no deploy com --var; PROXY_SHARED_SECRET é um secret do Worker.
  // Depois que o domínio estiver na Cloudflare, descomente e troque example.com pelo seu domínio:
  // "routes": [{ "pattern": "example.com", "custom_domain": true }]
}
